<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Tractor Talk 🎙️🚜</title>

  <meta name="description"
        content="Tractor Talk — a podcast hosted by Josh, Annika and Mila E. Watch full episodes on YouTube and follow us on TikTok.">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #10120f;
      color: #ffffff;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* =========================
       NAVIGATION
    ========================= */

    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 15px 6%;

      background: rgba(16, 18, 15, 0.88);
      backdrop-filter: blur(12px);

      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 10px;

      font-size: 1.25rem;
      font-weight: 900;
      letter-spacing: -0.5px;
    }

    .nav-logo img {
      width: 42px;
      height: 42px;
      object-fit: cover;
      border-radius: 10px;
    }

    .nav-links {
      display: flex;
      gap: 25px;
      font-weight: bold;
      font-size: 0.95rem;
    }

    .nav-links a {
      opacity: 0.8;
      transition: 0.2s;
    }

    .nav-links a:hover {
      opacity: 1;
      color: #d8ad45;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 100vh;

      display: flex;
      align-items: center;
      justify-content: center;

      text-align: center;

      padding: 120px 6% 80px;

      position: relative;
      overflow: hidden;

      background:
        linear-gradient(
          rgba(16,18,15,0.72),
          rgba(16,18,15,0.92)
        ),
        url("https://i.postimg.cc/mrBrW9tx/tractor.jpg");

      background-size: cover;
      background-position: center;
    }

    .hero-content {
      max-width: 850px;
      animation: fadeUp 1s ease;
    }

    .hero-logo {
      width: min(420px, 85vw);
      border-radius: 25px;

      margin-bottom: 25px;

      box-shadow:
        0 25px 70px rgba(0,0,0,0.55);
    }

    .hero h1 {
      font-size: clamp(2.7rem, 7vw, 5.5rem);
      line-height: 0.95;
      font-weight: 900;
      letter-spacing: -3px;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: #d8ad45;
    }

    .hero p {
      max-width: 650px;
      margin: 0 auto 30px;

      font-size: 1.15rem;
      color: #dddddd;
    }

    .buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      display: inline-block;

      padding: 14px 23px;

      border-radius: 999px;

      font-weight: 900;

      transition:
        transform 0.2s,
        box-shadow 0.2s,
        background 0.2s;
    }

    .btn:hover {
      transform: translateY(-3px);
    }

    .btn-primary {
      background: #d8ad45;
      color: #15150f;

      box-shadow: 0 10px 30px rgba(216,173,69,0.2);
    }

    .btn-primary:hover {
      background: #e8c565;
      box-shadow: 0 15px 35px rgba(216,173,69,0.3);
    }

    .btn-secondary {
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.06);
    }

    .btn-secondary:hover {
      background: rgba(255,255,255,0.12);
    }

    /* =========================
       GENERAL
    ========================= */

    section {
      padding: 90px 6%;
    }

    .container {
      max-width: 1150px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 50px;
    }

    .section-title small {
      display: block;

      color: #d8ad45;

      font-size: 0.8rem;
      font-weight: 900;

      letter-spacing: 2px;
      text-transform: uppercase;

      margin-bottom: 8px;
    }

    .section-title h2 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      line-height: 1;
      letter-spacing: -1.5px;
    }

    .section-title p {
      max-width: 600px;
      margin: 15px auto 0;
      color: #aaaaaa;
    }

    /* =========================
       ABOUT
    ========================= */

    .about {
      background: #171a15;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
    }

    .about-text h3 {
      font-size: 2rem;
      margin-bottom: 15px;
    }

    .about-text p {
      color: #bdbdbd;
      margin-bottom: 15px;
    }

    .tractor-card {
      position: relative;
      overflow: hidden;

      border-radius: 25px;

      min-height: 350px;

      box-shadow: 0 25px 60px rgba(0,0,0,0.3);
    }

    .tractor-card img {
      width: 100%;
      height: 100%;
      min-height: 350px;

      object-fit: cover;

      transition: transform 0.5s;
    }

    .tractor-card:hover img {
      transform: scale(1.05);
    }

    .tractor-label {
      position: absolute;
      bottom: 20px;
      left: 20px;

      padding: 10px 15px;

      border-radius: 12px;

      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(8px);

      font-weight: 900;
    }

    /* =========================
       WATCH / LISTEN
    ========================= */

    .listen {
      background: #10120f;
    }

    .listen-image {
      width: min(700px, 100%);
      display: block;

      margin: 0 auto 35px;

      border-radius: 22px;

      box-shadow: 0 25px 60px rgba(0,0,0,0.35);
    }

    .platform-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      max-width: 850px;
      margin: auto;
    }

    .platform {
      padding: 30px;

      border-radius: 22px;

      background: #1a1d18;
      border: 1px solid rgba(255,255,255,0.08);

      transition:
        transform 0.25s,
        border 0.25s;
    }

    .platform:hover {
      transform: translateY(-6px);
      border-color: rgba(216,173,69,0.5);
    }

    .platform-icon {
      font-size: 2.5rem;
      margin-bottom: 10px;
    }

    .platform h3 {
      font-size: 1.4rem;
      margin-bottom: 5px;
    }

    .platform p {
      color: #999999;
      margin-bottom: 18px;
    }

    .platform-link {
      color: #d8ad45;
      font-weight: 900;
    }

    /* =========================
       LATEST EPISODE
    ========================= */

    .episode {
      background: #171a15;
    }

    .episode-card {
      max-width: 850px;
      margin: auto;

      padding: 35px;

      border-radius: 25px;

      background:
        linear-gradient(
          135deg,
          #22261f,
          #171a15
        );

      border: 1px solid rgba(255,255,255,0.08);

      box-shadow: 0 25px 60px rgba(0,0,0,0.25);
    }

    .episode-number {
      display: inline-block;

      padding: 7px 12px;

      border-radius: 999px;

      background: #d8ad45;
      color: #15150f;

      font-size: 0.75rem;
      font-weight: 900;

      margin-bottom: 15px;
    }

    .episode-card h3 {
      font-size: 2rem;
      margin-bottom: 10px;
    }

    .episode-card p {
      color: #aaaaaa;
      margin-bottom: 25px;
    }

    .episode-placeholder {
      height: 180px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin-bottom: 25px;

      border-radius: 18px;

      background:
        repeating-linear-gradient(
          45deg,
          #20231e,
          #20231e 10px,
          #1c1f1b 10px,
          #1c1f1b 20px
        );

      color: #888888;
      font-weight: bold;
    }

    /* =========================
       CREW
    ========================= */

    .crew {
      background: #10120f;
    }

    .crew-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      max-width: 950px;
      margin: auto;
    }

    .person {
      padding: 30px 20px;

      text-align: center;

      background: #191c17;

      border-radius: 22px;

      border: 1px solid rgba(255,255,255,0.07);

      transition: transform 0.25s;
    }

    .person:hover {
      transform: translateY(-7px);
    }

    .person-avatar {
      width: 90px;
      height: 90px;

      margin: 0 auto 15px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background: #d8ad45;
      color: #17170f;

      font-size: 2rem;
      font-weight: 900;
    }

    .person h3 {
      margin-bottom: 4px;
    }

    .person p {
      color: #999999;
      font-size: 0.9rem;
    }

    /* =========================
       TOPICS
    ========================= */

    .topics {
      background: #171a15;
    }

    .topic-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .topic {
      padding: 25px;

      border-radius: 20px;

      background: #10120f;

      border: 1px solid rgba(255,255,255,0.07);
    }

    .topic span {
      font-size: 2rem;
      display: block;
      margin-bottom: 10px;
    }

    .topic h3 {
      margin-bottom: 5px;
    }

    .topic p {
      color: #999999;
      font-size: 0.9rem;
    }

    /* =========================
       CONTACT
    ========================= */

    .contact {
      text-align: center;
      background: #10120f;
    }

    .contact-box {
      max-width: 750px;
      margin: auto;

      padding: 45px 30px;

      border-radius: 25px;

      background: #1a1d18;

      border: 1px solid rgba(216,173,69,0.18);
    }

    .contact-box h2 {
      font-size: 2.2rem;
      margin-bottom: 10px;
    }

    .contact-box p {
      color: #aaaaaa;
      margin-bottom: 25px;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      padding: 35px 6%;

      text-align: center;

      background: #0b0d0a;

      border-top: 1px solid rgba(255,255,255,0.07);

      color: #777777;
    }

    footer strong {
      color: #ffffff;
    }

    .footer-links {
      margin-top: 10px;

      display: flex;
      justify-content: center;
      gap: 18px;

      font-size: 0.9rem;
    }

    .footer-links a:hover {
      color: #d8ad45;
    }

    /* =========================
       ANIMATION
    ========================= */

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(25px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 800px) {

      .nav-links {
        display: none;
      }

      nav {
        padding: 12px 5%;
      }

      .hero {
        padding-top: 110px;
      }

      .hero h1 {
        letter-spacing: -2px;
      }

      .about-grid {
        grid-template-columns: 1fr;
      }

      .platform-grid {
        grid-template-columns: 1fr;
      }

      .crew-grid {
        grid-template-columns: 1fr;
      }

      .topic-grid {
        grid-template-columns: 1fr;
      }

      section {
        padding: 70px 5%;
      }

      .episode-card {
        padding: 25px;
      }
    }

    @media (max-width: 450px) {

      .hero-logo {
        border-radius: 18px;
      }

      .buttons {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }

      .hero p {
        font-size: 1rem;
      }
    }

  </style>
</head>

